# This project is built and tested on Linux only. The test harness depends on
# shell scripts being executable and on Unix line endings, so pin both, and
# keep the checkout byte-identical no matter which platform clones it.
* text=auto eol=lf

*.c   text eol=lf
*.h   text eol=lf
*.sh  text eol=lf
*.py  text eol=lf
*.md  text eol=lf
Makefile text eol=lf

# Mark binary-ish things explicitly, in case build output is ever committed.
*.o     binary
*.a     binary
